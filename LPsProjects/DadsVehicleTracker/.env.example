# --- App ---
APP_USERNAME=family
APP_PASSWORD=changeme
FLASK_SECRET=please-change-me-to-a-long-random-string
PORT=5000

# --- Geofence + map ---
# Default geofence centers if you don't override; these match SF for local dev.
GARAGE1_LAT=37.7749
GARAGE1_LON=-122.4194
GARAGE2_LAT=37.7755
GARAGE2_LON=-122.4180
GARAGE3_LAT=37.7760
GARAGE3_LON=-122.4170

# --- Tesla Fleet API ---
# Leave TESLA_ACCESS_TOKEN empty to run the built-in simulator (vehicles
# orbit their owner's garage so the map + geofence code have data to work
# with locally). Set TRACKER_SIMULATE=0 to force the real API.
TESLA_ACCESS_TOKEN=
TESLA_VIN_DAD=
TESLA_VIN_LP=
TESLA_VIN_MOM=
TRACKER_SIMULATE=1

# --- Google Home (Shelly via existing Shelly Cloud skill) ---
# POST endpoint that fires the named Google Assistant Routine. See README
# for the IFTTT / Apps Script setup.
GOOGLE_ROUTINE_WEBHOOK_URL=
GOOGLE_ROUTINE_WEBHOOK_TOKEN=

# Routine names (must match what you set up in Google Home)
GARAGE1_OPEN_ROUTINE=Open Garage 1
GARAGE1_CLOSE_ROUTINE=Close Garage 1
GARAGE2_OPEN_ROUTINE=Open Garage 2
GARAGE2_CLOSE_ROUTINE=Close Garage 2
GARAGE3_OPEN_ROUTINE=Open Garage 3
GARAGE3_CLOSE_ROUTINE=Close Garage 3

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PHONE_DAD=
PHONE_LP=
PHONE_MOM=

# --- Tunables ---
TESLA_POLL_INTERVAL_S=30
GEOFENCE_DEBOUNCE_S=120
SMS_FALLBACK_AFTER_S=300
