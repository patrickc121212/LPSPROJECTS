# --- App ---
APP_USERNAME=family
APP_PASSWORD=changeme
FLASK_SECRET=please-change-me-to-a-long-random-string
PORT=5000

# --- Geofence + map ---
# Default geofence centers if you don't override; these match SF for local dev.
GARAGE1_LAT=37.7749
GARAGE1_LON=-122.4194
GARAGE2_LAT=37.7755
GARAGE2_LON=-122.4180
GARAGE3_LAT=37.7760
GARAGE3_LON=-122.4170

# --- Tesla Fleet API ---
# Developer app credentials (developer.tesla.com). Used by tesla_setup.py
# for partner registration + OAuth, and by the poller to refresh tokens.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# Domain hosting /.well-known/appspecific/com.tesla.3p.public-key.pem —
# must equal the app's Allowed Origin. Redirect URI must be in the app's list.
TESLA_DOMAIN=dowdsgarage.com
TESLA_REDIRECT_URI=https://dowdsgarage.com/callback
# User tokens written by `python tesla_setup.py login` (gitignored).
TESLA_TOKENS_PATH=data/tesla_tokens.json
# Virtual-key private key (P-256) matching the public key hosted on TESLA_DOMAIN.
TESLA_PRIVATE_KEY=data/tesla_private_key.pem
# Legacy: a static bearer token. Prefer the tokens file above; this dies in ~8h.
TESLA_ACCESS_TOKEN=
# From `python tesla_setup.py vehicles`
TESLA_VIN_DAD=
TESLA_VIN_LP=
TESLA_VIN_MOM=
TESLA_REGION=na

# Where positions come from: sim | telemetry | poll   (see telemetry/README.md)
#   sim        built-in simulator, no Tesla calls
#   telemetry  Fleet Telemetry push via MQTT — production, ~$0/mo
#   poll       vehicle_data polling — billed 500 calls/$1; keep TESLA_POLL_INTERVAL_S >= 300
VEHICLE_SOURCE=sim
TRACKER_SIMULATE=1

# --- Fleet Telemetry (VEHICLE_SOURCE=telemetry) ---
TELEMETRY_HOST=telemetry.dowdsgarage.com
TELEMETRY_PORT=443
TELEMETRY_CA_FILE=telemetry/certs/ca.pem
TELEMETRY_LOCATION_S=5
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# --- Google Home (Shelly via existing Shelly Cloud skill) ---
# POST endpoint that fires the named Google Assistant Routine. See README
# for the IFTTT / Apps Script setup.
GOOGLE_ROUTINE_WEBHOOK_URL=
GOOGLE_ROUTINE_WEBHOOK_TOKEN=

# Door owners (vehicle key). Defaults follow the physical bays: 1=mom 2=dad 3=lp.
GARAGE1_OWNER=mom
GARAGE2_OWNER=dad
GARAGE3_OWNER=lp

# Routine names (must match what you set up in Google Home)
GARAGE1_OPEN_ROUTINE=Open Garage 1
GARAGE1_CLOSE_ROUTINE=Close Garage 1
GARAGE2_OPEN_ROUTINE=Open Garage 2
GARAGE2_CLOSE_ROUTINE=Close Garage 2
GARAGE3_OPEN_ROUTINE=Open Garage 3
GARAGE3_CLOSE_ROUTINE=Close Garage 3

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PHONE_DAD=
PHONE_LP=
PHONE_MOM=

# --- Tunables ---
# Poll cadence. Drop to 2 for a quick simulator demo.
TESLA_POLL_INTERVAL_S=30
# Auto-open only fires on fence ENTRY; this guards against GPS jitter re-firing.
GEOFENCE_DEBOUNCE_S=120
# Unread for this long + driver not in the app for this long -> SMS nudge.
SMS_FALLBACK_AFTER_S=300
